# ==============================================================================
# TalentScope AI — Environment Configuration Example
# Copy to .env and customize for your environment.
# ==============================================================================

# --- Core Application ---
APP_NAME="TalentScope AI"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security & Encryption (REQUIRED IN PRODUCTION — CHANGE THESE!) ---
JWT_SECRET_KEY=replace-with-a-64-char-random-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Secret for encrypting CVs at rest. Any random string works (a Fernet key is used as-is).
# Auto-derived from JWT_SECRET_KEY if omitted. Never change it once CVs are stored.
FILE_ENCRYPTION_KEY=

# --- Database ---
# Local dev default (zero external dependencies):
DATABASE_URL=sqlite+aiosqlite:///./data/talentscope.db
# Production PostgreSQL + pgvector example:
# DATABASE_URL=postgresql+asyncpg://talentscope:talentscope@postgres:5432/talentscope

# --- Task Runner & Caching ---
# "local" runs autonomous searches in-process via asyncio; "celery" dispatches to Redis/Celery workers.
TASK_RUNNER_MODE=local
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- File Storage ---
# "local" (encrypted on disk), "s3" (AWS S3 / MinIO compatible), or
# "db" (encrypted inside the database; for hosts without persistent disks, e.g. Render free)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10
S3_BUCKET=talentscope-cvs
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# --- Malware Scanning ---
# Optional ClamAV daemon host/port for enterprise AV scanning (built-in structural & EICAR scanner always runs)
CLAMD_HOST=
CLAMD_PORT=3310

# --- LLM / AI Provider (Optional — Deterministic Hybrid NLP Engine Works Even Without Keys!) ---
# Supported providers: openai | anthropic | gemini | openai_compatible | none
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Permitted External Job Source API Keys (Optional) ---
# Open sources (Remotive, Arbeitnow, RemoteOK, The Muse, Jobicy, Himalayas,
# We Work Remotely RSS, JobTechDev Sweden, Greenhouse/Lever/Ashby direct ATS)
# work immediately with NO API keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=your-email@example.com
REED_API_KEY=
JSEARCH_API_KEY=

# --- Agent & Verification Tuning ---
HTTP_USER_AGENT="TalentScopeAI/1.0 (+https://talentscope.local/bot)"
SEARCH_HTTP_TIMEOUT_SECONDS=15
VERIFY_HTTP_TIMEOUT_SECONDS=8
DEFAULT_MAX_RESULTS_PER_SOURCE=25
VERIFY_MAX_CONCURRENCY=10
VERIFY_LIVE_URLS=true

# --- Frontend ---
# The Next.js server proxies /api/v1/* to BACKEND_URL (read at build time), so the browser
# only ever talks to the frontend origin.
BACKEND_URL=http://localhost:8000
# Optional: make the browser call the backend directly instead (requires CORS_ORIGINS).
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
